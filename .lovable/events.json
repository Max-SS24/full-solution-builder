{
  "schema_version": 1,
  "events": {
    "project.care_replacement_consent": {
      "event_schema_version": 1,
      "description": "A person accepts or declines a reopened-chat replacement offer using the button or chat; acceptance is counted even if the search later fails.",
      "privacy": {
        "contains_pii": false,
        "purpose": "product_analytics"
      },
      "properties_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "accepted",
          "method",
          "unavailable_count"
        ],
        "properties": {
          "accepted": {
            "type": "boolean"
          },
          "method": {
            "type": "string",
            "enum": [
              "button",
              "chat"
            ]
          },
          "unavailable_count": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "project.care_replacement_viewed": {
      "event_schema_version": 1,
      "description": "A newly provided replacement listing enters the viewport with at least half visible; counted once per listing per replacement batch, not when merely fetched.",
      "privacy": {
        "contains_pii": false,
        "purpose": "product_analytics"
      },
      "properties_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "option_count"
        ],
        "properties": {
          "option_count": {
            "type": "integer",
            "const": 1
          }
        }
      }
    },
    "project.prep_guidance_checked": {
      "event_schema_version": 1,
      "description": "A visitor pressed \"Check if this is current\" on appointment guidance; records whether VA.gov confirmed the items or the check failed.",
      "privacy": {
        "contains_pii": false,
        "purpose": "product_analytics"
      },
      "properties_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "outcome",
          "confirmed_count",
          "unconfirmed_count"
        ],
        "properties": {
          "outcome": {
            "type": "string",
            "enum": [
              "confirmed",
              "partly_confirmed",
              "not_confirmed",
              "check_failed"
            ]
          },
          "confirmed_count": {
            "type": "integer",
            "minimum": 0
          },
          "unconfirmed_count": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "project.recovery_code_sign_in": {
      "event_schema_version": 1,
      "description": "A person finished signing in using a recovery code.",
      "privacy": {
        "contains_pii": false,
        "purpose": "product_analytics"
      },
      "properties_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "codes_left"
        ],
        "properties": {
          "codes_left": {
            "type": "integer"
          }
        }
      }
    },
    "project.recovery_codes_generated": {
      "event_schema_version": 1,
      "description": "A person made a new set of recovery codes (first set or replacement).",
      "privacy": {
        "contains_pii": false,
        "purpose": "product_analytics"
      },
      "properties_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "first_set",
          "after_use"
        ],
        "properties": {
          "first_set": {
            "type": "boolean"
          },
          "after_use": {
            "type": "boolean"
          }
        }
      }
    },
    "project.recovery_codes_revoked": {
      "event_schema_version": 1,
      "description": "A person revoked all of their recovery codes from the account page.",
      "privacy": {
        "contains_pii": false,
        "purpose": "product_analytics"
      },
      "properties_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {}
      }
    },
    "project.reopened_care_options_checked": {
      "event_schema_version": 1,
      "description": "A saved chat finishes rechecking its care options; counts include unavailable options. Fires once per completed reopen.",
      "privacy": {
        "contains_pii": false,
        "purpose": "product_analytics"
      },
      "properties_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "checked_count",
          "unavailable_count"
        ],
        "properties": {
          "checked_count": {
            "type": "integer",
            "minimum": 0
          },
          "unavailable_count": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
